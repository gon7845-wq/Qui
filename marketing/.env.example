# ─── Général ────────────────────────────────────────────────────────────────
# Adresse publique du jeu, affichée dans la vidéo et les descriptions.
QUI_PUBLIC_URL=https://qui-production-8582.up.railway.app
# Plateformes à publier (vide = toutes celles configurées) : youtube,instagram,tiktok,uploadpost
PLATFORMS=
# 1 = tout faire sauf envoyer (affiche ce qui serait publié)
DRY_RUN=

# ─── YouTube Shorts (YouTube Data API v3) ───────────────────────────────────
# Client OAuth « Application de bureau » dans Google Cloud, scope youtube.upload.
# `npm run auth:youtube` te donne YT_REFRESH_TOKEN.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# public | unlisted | private
YT_PRIVACY=public

# ─── Instagram Reels (Instagram API with Instagram Login) ───────────────────
# Compte Instagram professionnel (Créateur ou Entreprise) + app Meta « Instagram ».
# `npm run auth:instagram` te donne IG_ACCESS_TOKEN (valide 60 jours, rafraîchi à chaque publication).
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
# « me » fonctionne avec un jeton Instagram Login ; sinon l'ID du compte professionnel.
IG_USER_ID=me
IG_API_VERSION=v23.0
# graph.instagram.com (Instagram Login) ou graph.facebook.com (Facebook Login)
IG_GRAPH_HOST=graph.instagram.com
# Instagram télécharge la vidéo depuis une URL publique : posée par le workflow (release GitHub).
MEDIA_URL=

# ─── TikTok (Content Posting API) ───────────────────────────────────────────
# App sur developers.tiktok.com avec le produit « Content Posting API » (Direct Post).
# `npm run auth:tiktok` te donne TT_REFRESH_TOKEN. Tant que l'app n'est pas auditée,
# TikTok impose des vidéos visibles par toi seul (SELF_ONLY).
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TT_PRIVACY=PUBLIC_TO_EVERYONE
TT_REDIRECT_URI=

# ─── Upload-Post (raccourci : une clé pour les 3 réseaux, payant au-delà de 10/mois) ─
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
UPLOAD_POST_PLATFORMS=tiktok,instagram,youtube
